# Copy to .env and fill in. Never commit .env.

# Stack Exchange: free key from https://stackapps.com/apps/oauth/register
# (see docs/stack-exchange-api-key-tutorial.md).
# Anonymous use is capped at 300/day, so a key is needed for fill. Use your OWN key and
# network: the 10,000/day quota is per key and per IP.
SE_API_KEY=
SE_SITE=stackoverflow
# API calls one run (fill or update) may spend. 10000 = the daily quota with a key. The
# next person's run picks up where this one stopped (cursors are stored in the database).
SE_MAX_REQUESTS=10000
# fill walks backward by creation date and stops here (YYYY-MM-DD). Check how much data your
# database can hold before moving this earlier: 10,000 calls is roughly 500,000+ questions.
SE_BACKFILL_FLOOR=2025-01-01
# Question pages (100 each) fetched per committed batch. Smaller = less lost if a run dies.
SE_BATCH_PAGES=10
# Cap on question pages one update run may pull (100 questions per page).
SE_MAX_PAGES=300
# Monthly question counts (dashboard Q1, Q2) start here.
SE_HISTORY_START=2020-01-01
SE_TRACKED_TAGS=python;javascript;java;c#;c++;reactjs;sql;typescript
# Seconds between API calls.
SE_REQUEST_INTERVAL=0.25

# SETUP A, Neon (shared team database): EITHER paste the connection string here, OR instead add
# the separate lines Neon's "Connect" dialog gives you (PGHOST, PGDATABASE, PGUSER, PGPASSWORD,
# PGSSLMODE, PGCHANNELBINDING) at the bottom of this file. Either way wins over POSTGRES_* below.
# A pooled host (contains "-pooler") is switched to the direct one automatically, because the
# pipeline creates tables and takes a database lock.
# SETUP B, local database: leave all of those out and fill in POSTGRES_USER / POSTGRES_PASSWORD
# below, then start it once with: docker compose --profile local up -d --wait db
# Both are explained in docs/docker.md.
DATABASE_URL=

# SETUP B only (local database; ignored when DATABASE_URL is set).
# POSTGRES_HOST is the compose service name; use localhost outside Docker.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=stackexchange
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port the local database is published on, on YOUR machine. Change it if 5432 is taken.
POSTGRES_PORT_ON_HOST=5432
# Local container has no SSL; leave as is. (Neon-style PGSSLMODE/PG* variables are ignored.)
POSTGRES_SSLMODE=prefer

# Neon's separate-lines format (alternative to DATABASE_URL above). Uncomment and fill in:
# PGHOST=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=require
# PGCHANNELBINDING=require
