# Copy to .env and fill in. Never commit .env.

# Stack Exchange: free key from https://stackapps.com/apps/oauth/register
# (see "Stack Exchange API Instructions/stack-exchange-api-key-tutorial.md").
# Required for a full first run (~1,000 requests); anonymous use is capped at 300/day.
SE_API_KEY=
SE_SITE=stackoverflow
# First-run window for row-level questions (YYYY-MM-DD). Blank = 60 days ago.
SE_START_DATE=
# Safety cap on question pages per run (100 questions per page).
SE_MAX_PAGES=300
# Monthly question counts (dashboard Q1, Q2) start here.
SE_HISTORY_START=2020-01-01
SE_TRACKED_TAGS=python;javascript;java;c#;c++;reactjs;sql;typescript
# Seconds between API calls.
SE_REQUEST_INTERVAL=0.25

# PostgreSQL. POSTGRES_HOST is the compose service name; use localhost outside Docker.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=stackexchange
POSTGRES_HOST=db
POSTGRES_PORT=5432
